<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog title="Rent Car" contentWidth="25rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Rental Period" labelFor="rentDateRange" />
                <DateRangeSelection
                    id="rentDateRange"
                    dateValue="{rent>/startDate}"
                    secondDateValue="{rent>/endDate}"
                    width="100%" />
                <Label text="Customer ID" labelFor="rentCustomerId" visible="{rent>/isAdmin}" />
                <Input
                    id="rentCustomerId"
                    value="{rent>/customerId}"
                    visible="{rent>/isAdmin}"
                    width="100%" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Rent" type="Emphasized" press=".onRentConfirm" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onRentCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
