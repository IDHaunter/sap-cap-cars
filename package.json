{
  "scripts": {
    "test": "cds test --profile test",
    "watch-cars": "cds watch --open sap.cap.cars.cars/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.0.2",
    "cds-plugin-ui5": "^0.17.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    },
    "[test]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  },
  "dependencies": {
    "@cap-js/mcp": "^1.4.3",
    "@sap/cds": "^10.0.6"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/cars"
  ]
}
