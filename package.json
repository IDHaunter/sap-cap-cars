{
  "scripts": {
    "test": "cds test --profile test",
    "watch-cars": "cds watch --open sap.cap.cars.cars/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.0.2",
    "cds-plugin-ui5": "^0.17.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "CUST000001": {
            "password": "password",
            "roles": [
              "User"
            ]
          },
          "CUST000002": {
            "password": "password",
            "roles": [
              "User"
            ]
          },
          "CUST000003": {
            "password": "password",
            "roles": [
              "User"
            ]
          },
          "admin": {
            "password": "admin",
            "roles": [
              "Admin"
            ]
          }
        }
      },
      "S4VehicleCatalog": {
        "kind": "odata",
        "model": "srv/external/S4VehicleCatalog"
      }
    },
    "[test]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  },
  "dependencies": {
    "@cap-js/mcp": "^1.4.3",
    "@sap/cds": "^10.0.6",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/cars"
  ]
}