      "seed": 1421111609,
      "version": 24,
      "versionNonce": 382934905,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787242083760,
      "link": null,
      "locked": false,
      "text": "case\n      when exists maintenances[startDate <= $now and endDate >= $now] then 'UM'\n      when exists rentals[startDate <= $now and endDate >= $now]      then 'RE'\n      else 'AV'\n    end as status_code : String(2),\n    status : Association to AvailabilityStatus on status.code = status_code",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "case\n      when exists maintenances[startDate <= $now and endDate >= $now] then 'UM'\n      when exists rentals[startDate <= $now and endDate >= $now]      then 'RE'\n      else 'AV'\n    end as status_code : String(2),\n    status : Association to AvailabilityStatus on status.code = status_code",
      "autoResize": false,
      "lineHeight": 1.25
    },
